{
  "name": "nook-notch",
  "productName": "Nook",
  "version": "0.1.0",
  "description": "A personal notch for Windows: music, calendar, tasks, clipboard, file shelf, phone drop, AI and more.",
  "main": "main.js",
  "private": true,
  "author": "via",
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "playwright-core": "^1.64.1",
    "qrcode-generator": "^1.5.2"
  },
  "devDependencies": {
    "electron": "^44.10.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "local.personal.nook",
    "productName": "Nook",
    "publish": null,
    "asar": true,
    "asarUnpack": ["lib/helper.ps1", "lib/helper-ui.cs", "lib/helper-control.ps1", "lib/helper-control.cs"],
    "directories": { "output": "dist" },
    "files": [
      "main.js", "preload.js", "lib/**/*", "renderer/**/*", "assets/**/*", "package.json", "node_modules/**/*",
      "!node_modules/**/*.{map,md,markdown}", "!node_modules/**/*.d.{ts,mts,cts}",
      "!node_modules/playwright-core/lib/vite/**"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [{ "target": "dir", "arch": ["x64"] }]
    }
  }
}
